FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    DOCKER=true

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl netcat-openbsd && \
    rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir uv && \
    uv pip install --system -r /app/requirements.txt --no-cache-dir

COPY backend /app/backend

WORKDIR /app/backend

EXPOSE 8000

HEALTHCHECK CMD python -c "import socket; s=socket.create_connection(('127.0.0.1',8000),2); s.close()" || exit 1

CMD ["python", "-m", "open_webui.mcp.agui_bridge.server", "--transport", "streamable-http", "--host", "0.0.0.0", "--port", "8000"]
